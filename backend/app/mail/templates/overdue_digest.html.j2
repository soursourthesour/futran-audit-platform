{% extends "_layout.html.j2" %}{% block body %}
<p>Hello {{ name }},</p>
<p>These commitments and remediation items for {{ organization }} are past their target date.</p>
{% for g in groups %}
<p style="margin:16px 0 4px"><strong>{{ g.owner }}</strong></p>
<ul style="margin:0;padding-left:18px">{% for i in g["items"] %}<li>{{ i.description }} · due {{ i.due }} ({{ i.kind }})</li>{% endfor %}</ul>
{% endfor %}
<p style="margin:24px 0"><a href="{{ link }}" style="background:#1B3A6B;color:#ffffff;padding:12px 20px;text-decoration:none;display:inline-block">Open in Futran Audit</a></p>
{% endblock %}
