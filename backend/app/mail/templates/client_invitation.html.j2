{% extends "_layout.html.j2" %}{% block body %}
<p>Dear {{ name }},</p>
<p>{{ chief_name or inviter_name }} has set up {{ organization_name }}'s AI governance assessment in the Futran Audit Platform{% if role_label %}. You are named as {{ role_label }}{% endif %}.</p>
{% if client_message %}<p>{{ client_message }}</p>{% endif %}
<p style="margin:24px 0"><a href="{{ accept_url }}" style="background:#1B3A6B;color:#ffffff;padding:12px 20px;text-decoration:none;display:inline-block">Accept invitation</a></p>
<p style="font-size:13px;color:#5b6474">This link is for you only and expires in 7 days. You will set a password{% if mfa_required %} and turn on multi-factor authentication{% endif %}. The engagement letter and the other initiation documents are in the platform; they are not attached to this email.</p>
{% endblock %}
