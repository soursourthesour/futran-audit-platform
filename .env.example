# Futran Audit Platform configuration. Copy to .env and adjust.
DATABASE_URL=sqlite:///./data/app.db
FILE_STORE=local:./data/files
# Sign-in codes (TOTP). Must be true before any client uses the platform.
MFA_REQUIRED=false
# outbox = emails are kept in the app (Admin > Outbox); smtp = send through the mailbox below.
EMAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Futran Audit Platform <no-reply@futransolutions.com>
# Claude law updates (Admin > Law updates). Leave blank to switch off.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Web search tool version for law updates; change if Anthropic publishes a newer one.
CLAUDE_WEB_SEARCH_TOOL=web_search_20250305
DATA_REGION_LABEL=us-east
SESSION_IDLE_MIN=30
SESSION_MAX_HOURS=12
RETENTION_YEARS_DEFAULT=7
VIRUS_SCAN=off
BASE_URL=http://localhost:8000
# Set to true only behind a proxy that sets X-Forwarded-For (Render, Azure App Service). Public-link rate limits then use the caller's real address.
TRUST_PROXY_HEADERS=false
# Address suggestions in the new-client wizard: photon (free, OpenStreetMap), google or off.
# Leave blank to use Google when GOOGLE_PLACES_API_KEY is set, otherwise Photon.
ADDRESS_AUTOCOMPLETE=
GOOGLE_PLACES_API_KEY=
# Email through Microsoft 365 and Google Workspace (README: "Email: Microsoft 365 and Google Workspace").
# Blank client IDs: email goes out through EMAIL_MODE above. While EMAIL_MODE=outbox both providers are simulated.
MAIL_PROVIDER_MODE=auto
# Entra ID app registration (multitenant web app). Redirect URI: BASE_URL/api/v1/mail/oauth/microsoft365
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=
# Google Cloud OAuth client (web application). Redirect URI: BASE_URL/api/v1/mail/oauth/google
# gmail.modify is a restricted scope: Google verification and a security assessment, or each client's Workspace
# admin marks the app as trusted in API controls.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Encrypts stored mailbox tokens. Blank derives a key from SECRET_KEY. Changing it means reconnecting mailboxes.
TOKEN_ENCRYPTION_KEY=
# Sending limits are configuration: Exchange Online allows 30 messages a minute and 500 recipients a message.
MAIL_PACE_PER_MINUTE=30
MAIL_BCC_BATCH_SIZE=450
MAIL_LINK_DAYS=14
# Long random string. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
